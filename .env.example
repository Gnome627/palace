# Home Assistant, как его видит контейнер. homeassistant.local внутри docker обычно не резолвится —
# лучше IP. HA на этом же хосте: http://host.docker.internal:8123
HA_URL=http://192.168.1.10:8123

# Долгосрочный токен: HA → профиль → Безопасность → Долгосрочные токены доступа
HA_TOKEN=

# Ключ для страницы (спросит один раз и запомнит в браузере). Пусто = панель открыта всем, кто до неё дотянется
API_KEY=

# Что панель не показывает, всё через запятую:
#   IGNORE_AREAS — id зон: router,servers
#   IGNORE_ENTITIES — шаблоны на entity_id целиком: switch.mikrotik_*,sensor.*_rssi
#   IGNORE_INTEGRATIONS — интеграции целиком: mikrotik_router,mobile_app,backup
IGNORE_AREAS=
IGNORE_ENTITIES=
IGNORE_INTEGRATIONS=

# Порт на хосте. Занят — любой свободный; 80 — чтобы открывать без порта в адресе
PALACE_PORT=8080

# Полный ресинк реестра, сек (между ними всё приходит событиями)
RESYNC_INTERVAL=900
# Сколько секунд ждать, что HA сообщит об изменении после команды. Пока ждём — карточка заблокирована;
# не дождались — страница предупредит
CONFIRM_TIMEOUT=10
LOG_LEVEL=INFO
